# Vite inlines these at BUILD time — set them before building / in the Vercel
# project settings, then rebuild after any change.

# Backend API base URL. No trailing slash, no /api suffix.
#   local:  http://localhost:5000
#   cloud:  https://<your-api>.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Google OAuth 2.0 Client ID (same value as the server's CLIENT_ID).
VITE_CLIENT_ID=651584680205-lei7817emktrvcojg7eegp1j28b99v0a.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────
#  PADDLE BILLING (v3) — placeholders until the live "Osek Patur" account
#  credentials exist. Purchase buttons show a friendly Hebrew error until
#  these are real; no code change is needed once they are.
# ─────────────────────────────────────────────────────────────
# Client-side token (public, safe to expose) — Paddle dashboard:
# Developer Tools > Authentication > Client-side tokens.
VITE_PADDLE_CLIENT_TOKEN=

# 'sandbox' while testing against a Paddle sandbox account, 'production' once live.
VITE_PADDLE_ENVIRONMENT=sandbox

# Price IDs from Paddle dashboard > Catalog > Prices — one Premium tier, two
# billing frequencies. Must match the same IDs configured server-side
# (PADDLE_PRICE_ID_MONTHLY / PADDLE_PRICE_ID_ANNUAL in server/.env.example)
# so the webhook maps either purchase back to SubscriptionTier.PREMIUM.
VITE_PADDLE_PRICE_ID_MONTHLY=
VITE_PADDLE_PRICE_ID_ANNUAL=

# ─────────────────────────────────────────────────────────────
#  ONESIGNAL — background/in-app push notifications. Placeholder until the
#  real OneSignal app exists; the SDK simply never initializes until this is
#  set — see services/oneSignal.ts.
# ─────────────────────────────────────────────────────────────
# OneSignal dashboard > Settings > Keys & IDs > OneSignal App ID (public,
# safe to expose) — same value as the server's ONESIGNAL_APP_ID.
VITE_ONESIGNAL_APP_ID=

# ─────────────────────────────────────────────────────────────
#  GOOGLE ADSENSE — banner ads for FREE-tier households only (see
#  components/AdsManager.tsx). Neither the loader script nor any ad slot
#  renders — for anyone — until both vars below are set.
# ─────────────────────────────────────────────────────────────
# AdSense account > Account > Settings > Account information > Publisher ID
# (the "ca-pub-..." value — public, safe to expose).
VITE_ADSENSE_CLIENT_ID=

# One AdSense ad unit's slot ID (AdSense > Ads > By ad unit > create a
# Display ad, then copy its data-ad-slot value).
VITE_ADSENSE_BANNER_SLOT_ID=

# ─────────────────────────────────────────────────────────────
#  SUPABASE REALTIME — receives the server's "something changed" broadcasts
#  instead of polling every few seconds (see services/realtime.ts). Read-only:
#  this key can only subscribe to broadcasts, never write anything. Falls
#  back to a slow safety-net poll until both vars below are set.
# ─────────────────────────────────────────────────────────────
# Supabase dashboard > Project Settings > Data API > Project URL. Same value
# as the server's SUPABASE_URL.
VITE_SUPABASE_URL=

# Supabase dashboard > Project Settings > API Keys > anon/public key (public,
# safe to expose — NOT the service_role key, which stays server-only).
VITE_SUPABASE_ANON_KEY=
