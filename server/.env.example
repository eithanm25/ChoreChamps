# ─────────────────────────────────────────────────────────────
#  LOCAL DEVELOPMENT
# ─────────────────────────────────────────────────────────────
SERVER_PORT=5000
NODE_ENV=development

# PostgreSQL (discrete vars — used only when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=chore_champs

# ─────────────────────────────────────────────────────────────
#  SECRETS (required in every environment)
# ─────────────────────────────────────────────────────────────
# 64-char random hex — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google OAuth 2.0 Client ID (the code reads CLIENT_ID, not GOOGLE_CLIENT_ID)
CLIENT_ID=

# Anthropic key for the AI chore-photo review (feature self-disables if unset)
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
#  OBJECT STORAGE — Cloudflare R2 (proof & reference photos)
# ─────────────────────────────────────────────────────────────
# From the Cloudflare dashboard: R2 > Overview (account id) and
# R2 > Manage API Tokens (an Object-Read-&-Write token scoped to the bucket).
# Uploads fail with a clear error until all five are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chorechamps-photos
# Public bucket URL — an R2 custom domain (recommended) or the r2.dev dev URL.
# No trailing slash.
R2_PUBLIC_BASE_URL=https://img.chorechamps.com

# ─────────────────────────────────────────────────────────────
#  PADDLE BILLING (v3) — placeholders until the live "Osek Patur" account
#  credentials exist. POST /api/payments/webhook returns 503 (not a crash)
#  until these are set; no code change is needed once they are.
# ─────────────────────────────────────────────────────────────
# Paddle dashboard > Developer Tools > Authentication > API keys.
PADDLE_API_KEY=

# Signing secret for this webhook's notification destination — Paddle
# dashboard > Developer Tools > Notifications > (your /api/payments/webhook
# destination) > "Signing secret".
PADDLE_WEBHOOK_SECRET=

# Price IDs from Paddle dashboard > Catalog > Prices — one Premium tier, two
# billing frequencies. Must match the client's VITE_PADDLE_PRICE_ID_MONTHLY /
# _ANNUAL exactly, so the webhook can map an incoming purchase back to
# SubscriptionTier.PREMIUM regardless of which one the parent picked.
PADDLE_PRICE_ID_MONTHLY=
PADDLE_PRICE_ID_ANNUAL=

# 'sandbox' while testing against a Paddle sandbox account, 'production' once live.
PADDLE_ENVIRONMENT=sandbox

# ─────────────────────────────────────────────────────────────
#  ONESIGNAL — real-time push notifications (task/reward/wallet alerts).
#  Placeholders until the real OneSignal app exists; sendPush warns and no-ops
#  instead of crashing until both are set — see services/oneSignal.ts.
# ─────────────────────────────────────────────────────────────
# OneSignal dashboard > Settings > Keys & IDs > OneSignal App ID. Same public
# value as the client's VITE_ONESIGNAL_APP_ID — App IDs are not secret.
ONESIGNAL_APP_ID=

# OneSignal dashboard > Settings > Keys & IDs > REST API Key. Secret — used
# only server-side to authorize POST /api/v1/notifications.
ONESIGNAL_API_KEY=

# ─────────────────────────────────────────────────────────────
#  CLOUD DEPLOYMENT (set in the Render/Railway dashboard, NOT here)
# ─────────────────────────────────────────────────────────────
# PORT is injected automatically by Render/Railway.

# Supabase "Session pooler" connection string (port 5432). When set, it takes
# precedence over the DB_* vars above and TLS is enabled automatically.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Schema bootstrap. Set to true for the FIRST cloud deploy only (creates tables
# in the empty database), then set to false and redeploy. Leave unset locally.
# DB_SYNCHRONIZE=false

# NODE_ENV=production

# Comma-separated browser origins allowed to call the API (no trailing slash).
# CORS_ORIGINS=https://chorechamps.com,https://www.chorechamps.com,http://localhost:5173

# Public frontend URL — used to build co-parent / child invite links.
# APP_BASE_URL=https://chorechamps.com
